# ---------- SMTP SETTINGS ----------
SMTP_HOST=smtp.sinbfir.org.br
SMTP_PORT=587
# true for port 465 (SSL), false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=sandro@sinbfir.org.br
SMTP_PASS=sinbfir.sandro

# ---------- SENDER ----------
FROM_NAME=NAV
FROM_EMAIL=sandro@sinbfir.org.br
# optional
REPLY_TO=sandro@sinbfir.org.br

# ---------- SENDING OPTIONS ----------
# text or html
CONTENT_FORMAT=text
# pause between each email in milliseconds (0 = no pause)
DELAY_MS=1000
# true = only print what would be sent, nothing goes out
DRY_RUN=false
